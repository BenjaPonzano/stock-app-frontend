# Copiar como .env si hace falta apuntar a otro backend.
# Si no existe el archivo, se usa http://localhost:3001/api por defecto.
# Ojo: Create React App solo lee variables que empiecen con REACT_APP_,
# y hay que reiniciar npm start despues de cambiarlas.

REACT_APP_API_URL=http://localhost:3001/api
